{
  "Comment": "ML Factory - EDA stage. Profiles an approved dataset and screens it for leakage, then hands control back to the data scientist for feature review.",
  "StartAt": "MarkEdaRunning",
  "States": {
    "MarkEdaRunning": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName.$": "$.experiments_table",
        "Key": { "experiment_id": { "S.$": "$.experiment_id" } },
        "UpdateExpression": "SET #status = :status, current_stage = :stage, updated_at = :now",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "EDA_RUNNING" },
          ":stage": { "S": "profiling" },
          ":now": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": null,
      "Next": "RunProfiling"
    },
    "RunProfiling": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('mlf-eda-{}', $.experiment_id)",
        "RoleArn": "${JobRoleArn}",
        "AppSpecification": {
          "ImageUri": "${JobImageUri}",
          "ContainerEntrypoint": ["python", "-m", "jobs.profiling.main"],
          "ContainerArguments.$": "States.Array('--experiment-id', $.experiment_id, '--artifact-base', $.output_s3_prefix, '--dataset-uri', $.dataset_s3_uri, '--target-column', $.target_column, '--file-format', $.file_format)"
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": ${ProcessingInstanceCount},
            "InstanceType": "${ProcessingInstanceType}",
            "VolumeSizeInGB": ${ProcessingVolumeSizeGb},
            "VolumeKmsKeyId": "${KmsKeyId}"
          }
        },
        "NetworkConfig": {
          "EnableInterContainerTrafficEncryption": true,
          "EnableNetworkIsolation": false
        },
        "StoppingCondition": { "MaxRuntimeInSeconds": ${MaxRuntimeSeconds} },
        "Environment": { "ML_FACTORY_LOG_LEVEL": "INFO" }
      },
      "ResultPath": "$.profiling_result",
      "Retry": [
        {
          "ErrorEquals": ["SageMaker.AmazonSageMakerException", "SageMaker.ResourceLimitExceededException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }
      ],
      "Next": "MarkEdaCompleted"
    },
    "MarkEdaCompleted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName.$": "$.experiments_table",
        "Key": { "experiment_id": { "S.$": "$.experiment_id" } },
        "UpdateExpression": "SET #status = :status, current_stage = :stage, updated_at = :now",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "EDA_COMPLETED" },
          ":stage": { "S": "eda_completed" },
          ":now": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": null,
      "Next": "MarkFeatureReview"
    },
    "MarkFeatureReview": {
      "Comment": "Feature review is human time, so the execution ends here rather than waiting. Training is a separate execution started by the control plane.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName.$": "$.experiments_table",
        "Key": { "experiment_id": { "S.$": "$.experiment_id" } },
        "UpdateExpression": "SET #status = :status, current_stage = :stage, updated_at = :now",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "FEATURE_REVIEW" },
          ":stage": { "S": "feature_review" },
          ":now": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": null,
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName.$": "$.experiments_table",
        "Key": { "experiment_id": { "S.$": "$.experiment_id" } },
        "UpdateExpression": "SET #status = :status, current_stage = :stage, failure_code = :code, failure_message = :message, updated_at = :now",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "FAILED" },
          ":stage": { "S": "profiling" },
          ":code": { "S": "EDA_JOB_FAILED" },
          ":message": { "S.$": "States.Format('The profiling job did not complete: {}', $.error.Cause)" },
          ":now": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": null,
      "Next": "EdaFailed"
    },
    "EdaFailed": {
      "Type": "Fail",
      "Error": "EdaJobFailed",
      "Cause": "The profiling job failed. The experiment record carries the user-facing reason and eda/failure.json carries the detail."
    }
  }
}
