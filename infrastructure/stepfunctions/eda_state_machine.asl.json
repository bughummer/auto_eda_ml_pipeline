{
  "Comment": "ML Factory - EDA stage. Profiles an approved dataset and screens it for leakage, then hands control back to the data scientist for feature review.",
  "StartAt": "MarkEdaRunning",
  "States": {
    "MarkEdaRunning": {
      "Comment": "The experiment record lives with the artifacts; each writer owns its own object.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket.$": "$.artifact_bucket",
        "Key.$": "$.state_key",
        "ContentType": "application/json",
        "Body.$": "States.Format('{{\"experiment_id\":\"{}\",\"updated_at\":\"{}\",\"status\":\"EDA_RUNNING\",\"current_stage\":\"profiling\"}}', $.experiment_id, $$.State.EnteredTime)"
      },
      "ResultPath": null,
      "Next": "RunProfiling"
    },
    "RunProfiling": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('mlf-eda-{}', $.experiment_id)",
        "RoleArn": "${JobRoleArn}",
        "AppSpecification": {
          "ImageUri": "${JobImageUri}",
          "ContainerEntrypoint": [
            "python",
            "-m",
            "jobs.profiling.main"
          ],
          "ContainerArguments.$": "States.Array('--experiment-id', $.experiment_id, '--artifact-base', $.output_s3_prefix, '--dataset-uri', $.dataset_s3_uri, '--target-column', $.target_column, '--file-format', $.file_format)"
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": ${ProcessingInstanceCount},
            "InstanceType": "${ProcessingInstanceType}",
            "VolumeSizeInGB": ${ProcessingVolumeSizeGb},
            "VolumeKmsKeyId": "${KmsKeyId}"
          }
        },
        "NetworkConfig": {
          "EnableInterContainerTrafficEncryption": true,
          "EnableNetworkIsolation": false
        },
        "StoppingCondition": {
          "MaxRuntimeInSeconds": ${MaxRuntimeSeconds}
        },
        "Environment": {
          "ML_FACTORY_LOG_LEVEL": "INFO"
        }
      },
      "ResultPath": "$.profiling_result",
      "Retry": [
        {
          "ErrorEquals": [
            "SageMaker.AmazonSageMakerException",
            "SageMaker.ResourceLimitExceededException"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "MarkEdaCompleted"
    },
    "MarkEdaCompleted": {
      "Comment": "The experiment record lives with the artifacts; each writer owns its own object.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket.$": "$.artifact_bucket",
        "Key.$": "$.state_key",
        "ContentType": "application/json",
        "Body.$": "States.Format('{{\"experiment_id\":\"{}\",\"updated_at\":\"{}\",\"status\":\"EDA_COMPLETED\",\"current_stage\":\"eda_completed\"}}', $.experiment_id, $$.State.EnteredTime)"
      },
      "ResultPath": null,
      "Next": "MarkFeatureReview"
    },
    "MarkFeatureReview": {
      "Comment": "Feature review is human time, so the execution ends here rather than waiting. Training is a separate execution started by the control plane.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket.$": "$.artifact_bucket",
        "Key.$": "$.state_key",
        "ContentType": "application/json",
        "Body.$": "States.Format('{{\"experiment_id\":\"{}\",\"updated_at\":\"{}\",\"status\":\"FEATURE_REVIEW\",\"current_stage\":\"feature_review\"}}', $.experiment_id, $$.State.EnteredTime)"
      },
      "ResultPath": null,
      "End": true
    },
    "MarkFailed": {
      "Comment": "The experiment record lives with the artifacts; each writer owns its own object.",
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket.$": "$.artifact_bucket",
        "Key.$": "$.state_key",
        "ContentType": "application/json",
        "Body.$": "States.Format('{{\"experiment_id\":\"{}\",\"updated_at\":\"{}\",\"status\":\"FAILED\",\"current_stage\":\"profiling\",\"failure_code\":\"EDA_JOB_FAILED\",\"failure_message\":\"The stage did not complete. Its failure artifact and the execution history carry the detail: {}\"}}', $.experiment_id, $$.State.EnteredTime, $$.Execution.Id)"
      },
      "ResultPath": null,
      "Next": "EdaFailed"
    },
    "EdaFailed": {
      "Type": "Fail",
      "Error": "EdaJobFailed",
      "Cause": "The profiling job failed. The experiment record carries the user-facing reason and eda/failure.json carries the detail."
    }
  }
}
