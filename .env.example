# ML Factory configuration. Copy to .env and adjust. Never commit real values.
#
# Credentials do NOT belong here. Copy config/secrets/config.sample.py to
# config/secrets/config.py and type them there; that file is gitignored.
# Anything set in this file, or in the environment, overrides the values there.

# local  -> LocalObjectStore + in-process orchestrator (no AWS required)
# aws    -> S3 + Step Functions + DynamoDB
ML_FACTORY_MODE=local

ML_FACTORY_LOCAL_ROOT=./var/ml-factory
# Host directory holding datasets in local mode. The container mounts it read-only at
# /data, so the UI takes paths like /data/customer_churn.csv.
# ML_FACTORY_DATA_DIR=/mnt/shared/datasets
ML_FACTORY_API_PREFIX=/api/v1
ML_FACTORY_CORS_ORIGINS=["http://localhost:5173"]
ML_FACTORY_LOG_LEVEL=INFO

# Set only when one process serves the API and the built UI (the container image sets it).
# Leave unset for development, where Vite serves the frontend on :5173.
# ML_FACTORY_STATIC_DIR=/app/frontend/dist

# --- AWS mode -------------------------------------------------------------
ML_FACTORY_AWS_REGION=eu-central-1
ML_FACTORY_ARTIFACT_BUCKET=s3://my-ml-factory-artifacts
ML_FACTORY_ALLOWED_DATASET_PREFIXES=["s3://my-approved-data/curated"]
ML_FACTORY_EDA_STATE_MACHINE_ARN=
ML_FACTORY_TRAINING_STATE_MACHINE_ARN=
ML_FACTORY_EXPERIMENTS_TABLE=ml-factory-experiments
ML_FACTORY_KMS_KEY_ID=

# --- Bedrock (reasoning layer) -------------------------------------------
ML_FACTORY_BEDROCK_ENABLED=false
ML_FACTORY_BEDROCK_MODEL_ID=
ML_FACTORY_BEDROCK_MAX_TOKENS=4096

# --- Credentials ----------------------------------------------------------
# Set in config/secrets/config.py, not here. Uncomment only to point the platform at a
# different credentials file (the container mounts config/secrets read-only).
# ML_FACTORY_SECRETS_FILE=config/secrets/config.py

# --- Corporate proxy ------------------------------------------------------
# HTTPS_PROXY=http://proxy.corp.example:3128
# NO_PROXY=localhost,127.0.0.1,.corp.example
